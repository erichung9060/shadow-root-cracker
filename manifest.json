{
    "name": "ShadowRootCracker",
    "description": "Reload shadow-root(closed) on web pages as shadow-root(open)",
    "version": "1.0",
    "manifest_version": 3,
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN",
            "js": [
                "shadowInject.js"
            ]
        }
    ]
}
